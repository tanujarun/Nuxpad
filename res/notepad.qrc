    <file alias="selawkb.ttf">fonts/selawkb.ttf</file>
    <file alias="selawksb.ttf">fonts/selawksb.ttf</file>
    <file alias="NotepadMono-Regular.ttf">fonts/NotepadMono-Regular.ttf</file>
    <file alias="NotepadMono-Bold.ttf">fonts/NotepadMono-Bold.ttf</file>
  </qresource>
</RCC>
